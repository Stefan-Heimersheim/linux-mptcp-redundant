# Kconfig fragment merged on top of x86_64 defconfig for the test VM.
# Everything the netns test and the upstream mptcp selftests need is built in
# (=y) so the vng guest needs no module loading.
CONFIG_MPTCP=y
CONFIG_MPTCP_IPV6=y
CONFIG_IPV6=y
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_KALLSYMS=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_MPTCP_DIAG=y
CONFIG_SYN_COOKIES=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_CSUM=y
CONFIG_NET_ACT_PEDIT=y
CONFIG_NET_ACT_GACT=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_SOCKET=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEBUG_INFO_NONE=y
# Werror in net/mptcp is enforced separately by test/check.sh (grep on build log)
# The rpi-6.12.y tree does not link with x86_64 defconfig graphics enabled
# (drivers/gpu/drm/bridge/panel.c: undefined reference to
# backlight_set_display_name, a downstream Raspberry Pi patch). The VM is
# headless anyway, so drop DRM and sound; this also makes builds much faster.
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# Options virtme-ng needs in the guest (virtiofs rootfs, virtio devices,
# overlayfs). `vng --kconfig` (virtme-configkernel --update) did not apply
# them on this host, so they are listed explicitly here.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_DAX=y
CONFIG_FS_DAX=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX98_PTYS=y
CONFIG_INOTIFY_USER=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_I6300ESB_WDT=y
# CONFIG_UEVENT_HELPER is not set
